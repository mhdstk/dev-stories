{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out/test",
    "rootDir": "./",
    "types": ["node", "jest", "mocha"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "strict": false
  },
  "include": [
    "test/**/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "webview-ui"
  ]
}