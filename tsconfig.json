{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@/core/*": ["./core/*"],
      "@/services/*": ["./services/*"],
      "@/ui/*": ["./ui/*"],
      "@/storage/*": ["./storage/*"],
      "@/types/*": ["./types/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview-ui",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}